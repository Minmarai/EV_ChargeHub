<html><head><title>Profile</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/user-sidebar.jsp"/><main class="main"><div class="form-card card"><h2>My Profile</h2><form method="post"><input type="hidden" name="action" value="profile"><label>Name</label><input class="input" name="fullName" value="${user.fullName}"><label>Phone</label><input class="input" name="phone" value="${user.phone}"><label>Vehicle Number</label><input class="input" name="vehicleNumber" value="${user.vehicleNumber}"><label>Address</label><textarea class="input" name="address">${user.address}</textarea><button class="btn">Update Profile</button></form></div></main></div></body></html>
