<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Station Details</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/user-sidebar.jsp"/><main class="main"><div class="grid"><div class="card"><h1>${station.stationName}</h1><p>${station.districtName}</p><p>${station.address}</p><p>Contact: ${station.contactNumber}</p><p>Charger: ${station.chargerType}</p><p>Time: ${station.openingTime} - ${station.closingTime}</p><p>Price: Rs. ${station.pricePerHour}/hr</p></div><div class="card"><h2>Book Slot</h2><form method="post"><input type="hidden" name="action" value="book"><input type="hidden" name="stationId" value="${station.stationId}"><label>Available Slot</label><select name="slotId" required><c:forEach var="sl" items="${slots}"><option value="${sl.slotId}">${sl.slotDate} ${sl.startTime}-${sl.endTime}</option></c:forEach></select><label>Vehicle Number</label><input class="input" name="vehicleNumber" required><label>Note</label><textarea class="input" name="notes"></textarea><button class="btn">Confirm Booking</button></form></div></div><div class="card"><h2>Reviews</h2><form method="post"><input type="hidden" name="action" value="review"><input type="hidden" name="stationId" value="${station.stationId}"><label>Rating</label><select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select><label>Comment</label><textarea class="input" name="comment"></textarea><button class="btn secondary">Submit Review</button></form><c:forEach var="r" items="${reviews}"><p><b>${r.full_name}</b> rated ${r.rating}/5 — ${r.comment}</p></c:forEach></div></main></div></body></html>
