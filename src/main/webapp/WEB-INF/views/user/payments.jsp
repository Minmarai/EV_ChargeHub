<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Payments</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/user-sidebar.jsp"/><main class="main"><h1>Payment History</h1><table><tr><th>ID</th><th>Booking</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr><c:forEach var="p" items="${payments}"><tr><td>${p.paymentId}</td><td>${p.bookingId}</td><td>${p.amount}</td><td>${p.paymentMethod}</td><td>${p.paymentStatus}</td><td>${p.paymentDate}</td></tr></c:forEach></table></main></div></body></html>
