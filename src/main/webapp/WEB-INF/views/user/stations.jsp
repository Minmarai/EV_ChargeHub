<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Stations</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/user-sidebar.jsp"/><main class="main"><h1>Search Charging Stations</h1><form class="card" method="get"><div class="grid"><div><label>District</label><select name="districtId"><option value="0">All Districts</option><c:forEach var="d" items="${districts}"><option value="${d.districtId}">${d.districtName}</option></c:forEach></select></div><div><label>Charger Type</label><select name="chargerType"><option value="">All</option><option>Fast Charger</option><option>DC Charger</option><option>AC Charger</option></select></div><div><label>&nbsp;</label><button class="btn">Search</button></div></div></form><div class="grid"><c:forEach var="s" items="${stations}"><div class="card station-card"><h3>${s.stationName}</h3><p>${s.districtName} • ${s.chargerType}</p><p>${s.address}</p><p>Ports: ${s.totalPorts} | Rs. ${s.pricePerHour}/hr</p><a class="btn" href="${pageContext.request.contextPath}/user/station?id=${s.stationId}">View Details</a><form method="post" style="display:inline"><input type="hidden" name="action" value="favorite"><input type="hidden" name="stationId" value="${s.stationId}"><button class="btn secondary">Favorite</button></form></div></c:forEach></div></main></div></body></html>
