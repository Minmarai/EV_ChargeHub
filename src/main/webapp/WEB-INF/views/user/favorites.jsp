<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Favorites</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/user-sidebar.jsp"/><main class="main"><h1>Favorite Stations</h1><div class="grid"><c:forEach var="s" items="${favorites}"><div class="card"><h3>${s.stationName}</h3><p>${s.districtName} • ${s.chargerType}</p><a class="btn" href="${pageContext.request.contextPath}/user/station?id=${s.stationId}">View</a><form method="post"><input type="hidden" name="action" value="removeFavorite"><input type="hidden" name="stationId" value="${s.stationId}"><button class="btn danger">Remove</button></form></div></c:forEach></div></main></div></body></html>
