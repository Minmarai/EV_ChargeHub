<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Payments</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/admin-sidebar.jsp"/><main class="main"><h1>All Payments</h1><table><tr><th>ID</th><th>User</th><th>Station</th><th>Amount</th><th>Method</th><th>Status</th><th>Action</th></tr><c:forEach var="p" items="${payments}"><tr><td>${p.paymentId}</td><td>${p.userName}</td><td>${p.stationName}</td><td>${p.amount}</td><td>${p.paymentMethod}</td><td>${p.paymentStatus}</td><td><a class="btn secondary" href="${pageContext.request.contextPath}/admin/payment?id=${p.paymentId}">View</a><form method="post"><input type="hidden" name="action" value="paymentStatus"><input type="hidden" name="paymentId" value="${p.paymentId}"><select name="status"><option>paid</option><option>pending</option><option>failed</option><option>refunded</option></select><button class="btn">Update</button></form></td></tr></c:forEach></table></main></div></body></html>
