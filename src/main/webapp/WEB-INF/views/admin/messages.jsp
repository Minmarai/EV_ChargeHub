<%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Messages</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><div class="layout"><jsp:include page="../common/admin-sidebar.jsp"/><main class="main"><h1>Contact Messages</h1><table><tr><th>Name</th><th>Email</th><th>Subject</th><th>Message</th><th>Status</th><th>Action</th></tr><c:forEach var="m" items="${messages}"><tr><td>${m.name}</td><td>${m.email}</td><td>${m.subject}</td><td>${m.message}</td><td>${m.status}</td><td><form method="post"><input type="hidden" name="action" value="readMessage"><input type="hidden" name="messageId" value="${m.message_id}"><button class="btn secondary">Read</button></form><form method="post"><input type="hidden" name="action" value="deleteMessage"><input type="hidden" name="messageId" value="${m.message_id}"><button class="btn danger">Delete</button></form></td></tr></c:forEach></table></main></div></body></html>
